# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
DATA_DIR=data
DUCKDB_PATH=data/health.duckdb
SQLITE_URL=sqlite:///data/mizaj.sqlite
APP_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5
LOG_LEVEL=INFO

